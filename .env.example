ADMIN_USERNAME=admin
# Set a unique password of at least 12 characters.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Production URL, used to validate admin requests. Local default: http://localhost:3001
APP_URL=http://localhost:3001
# Optional durable disk location. Default: ./data (single server only).
# DATA_DIR=/path/to/persistent/dravohome-data
# PDF storage: local (default) or r2. Metadata and contact settings still use DATA_DIR.
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=r2. Create an R2 bucket and an API token
# with Object Read & Write permission scoped to that bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
